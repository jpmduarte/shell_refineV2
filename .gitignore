# Generated data — regenerate with cache.py, make_sdf.py, phase2/make_crops.py.
# cache/ alone is ~11GB; none of this is source.
cache/
phase1/runs/
phase2/runs/
phase2/crops/
preds*/
*.npz
*.npy
*.pth
*.nii
*.nii.gz

# Fold assignment is generated by splits.py, but it MUST stay fixed for results to
# be comparable across runs and phases — so it is tracked deliberately.
!splits.json

# Logs and profiling output
logs/*
!logs/.gitkeep
slurm-*.out
slurm-*.err

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Editors / OS / tooling
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
