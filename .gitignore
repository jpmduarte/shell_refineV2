# Generated data — regenerate with cache.py, make_sdf.py, size_norm.py.
# cache/ alone is ~9GB; none of this is source.
caches/
size_normalization_approach/runs/
nnunet/runs/
preds*/
*.npz
*.npy
*.pth
*.nii
*.nii.gz
# Every other volume format (MITK saves .nrrd; DICOM, MetaImage, MGH, VTK), and checkpoints
*.nrrd
*.mha
*.mhd
*.raw
*.dcm
*.mgz
*.vtk
*.pt

# Fold assignment is generated by splits.py, but it MUST stay fixed for results to
# be comparable across runs — so it is tracked deliberately.
!splits.json

# Logs and profiling output
logs/*
!logs/.gitkeep

# Job queue state — the runner recreates these; the jobs themselves are transient
queue/
slurm-*.out
slurm-*.err

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Editors / OS / tooling
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
boundary_refiner_2_phase_approach/phase2/runs/
boundary_refiner_2_phase_approach/phase2/crops/
boundary_refiner_2_phase_approach/priors/
